{
  "name": "web-drawing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "rm -rf dist && bun build ./src/index.html --outdir=dist --target=browser && cp THIRD_PARTY_NOTICES.md dist/THIRD_PARTY_NOTICES.md",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run tests/browser.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "perfect-freehand": "1.2.3"
  }
}
